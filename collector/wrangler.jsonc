{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "course-atlas-ntulearn-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "triggers": { "crons": [] },
  "kv_namespaces": [
    { "binding": "STATE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "SITES_URL": "https://fatemeeting.site",
    "TARGET_COURSE_ID": "_2706629_1",
    "TARGET_COURSE_CODE": "EE6497",
    "TARGET_COURSE_NAME": "Pattern Recognition & Deep Learning",
    "MAX_COURSES": "1",
    "MAX_ITEMS_PER_COURSE": "10"
  }
}
