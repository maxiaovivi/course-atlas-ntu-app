{
  "expo": {
    "name": "知屿课表",
    "slug": "maxiaovivi",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/ink-tree-icon.png",
    "scheme": "courseatlasntu",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.maxiaovivi.courseatlasntu",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F8F8F5",
        "foregroundImage": "./assets/images/ink-tree-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/course-atlas-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8F5",
          "image": "./assets/images/ink-tree-icon.png",
          "imageWidth": 196
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/cca13353-70fe-43e0-a256-3de3b76a8317"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cca13353-70fe-43e0-a256-3de3b76a8317"
      }
    },
    "owner": "maxiaovivis-team"
  }
}
